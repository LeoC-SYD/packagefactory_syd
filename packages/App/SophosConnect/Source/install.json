{
  "PackageInformation": {
    "SetupType": "MSI",
    "SetupFile": "SophosConnect_2.4.0(IPsec_and_SSLVPN).msi",
    "Version": "2.4"
  },
  "LogPath": "C:\\ProgramData\\Microsoft\\IntuneManagementExtension\\Logs",
  "InstallTasks": {
